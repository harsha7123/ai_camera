{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeoatap.local/tools/eval/ground_truth.v2.json",
  "title": "Zeoatap Restaurant Watchdog ground-truth annotations v2",
  "description": "Event-level ground truth for the restaurant event types in packages/contracts/API.md. One file holds one or more recording sessions. All ids are pseudonymous; no names, faces or employee numbers. Times are RFC 3339 (start/end) or seconds from the session's t0 (start_s/end_s); never both in one event.",
  "type": "object",
  "required": [
    "schema_version",
    "sessions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test",
            "ood_test",
            "pilot",
            "synthetic"
          ]
        },
        "locked": {
          "type": "boolean",
          "description": "Test sets must be locked (frozen and versioned) before evaluation."
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "$defs": {
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "type": "object",
      "required": [
        "session_id",
        "facility_id",
        "camera_id",
        "conditions",
        "operating_span",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "facility_id": {
          "type": "string",
          "minLength": 1,
          "description": "Pseudonymous site id."
        },
        "camera_id": {
          "type": "string",
          "minLength": 1,
          "description": "Primary camera; must equal the camera id used by vision-worker/core (e.g. cam-counter)."
        },
        "extra_camera_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other cameras covering the same room zones. An incident is in scope for this session if its cameras intersect camera_id + extra_camera_ids."
        },
        "room_id": {
          "type": "string",
          "description": "Core room id, e.g. counter, dining, kitchen, back."
        },
        "subject": {
          "type": "string",
          "description": "Pseudonymous actor id for staged sessions, e.g. actor-A2. Never a real name or POS employee number."
        },
        "consent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Consent / written acknowledgment records for the staff and actors in the recording."
        },
        "t0": {
          "$ref": "#/$defs/time",
          "description": "Wall time of video frame 0. Required when events use start_s/end_s."
        },
        "recording": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "resolution": {
              "type": "string",
              "pattern": "^[0-9]+x[0-9]+$"
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "codec": {
              "type": "string"
            },
            "source_file": {
              "type": "string"
            }
          }
        },
        "conditions": {
          "type": "object",
          "required": [
            "lighting",
            "crowding",
            "camera_view"
          ],
          "additionalProperties": true,
          "description": "Session-level strata. Events may override any key in their own conditions.",
          "properties": {
            "lighting": {
              "enum": [
                "day",
                "night",
                "after_hours_dark"
              ],
              "description": "day: daylight / normal service lighting; night: evening with interior lights on; after_hours_dark: lights off after close (IR or minimal light)."
            },
            "crowding": {
              "enum": [
                "empty",
                "normal",
                "rush"
              ],
              "description": "People in view: empty (0-1), normal service, rush (queue, full dining room)."
            },
            "camera_view": {
              "enum": [
                "overhead",
                "360",
                "wide"
              ],
              "description": "overhead: POS/register camera looking down; 360: fisheye dome over an open floor; wide: wall-mounted wide angle (kitchen, back door, entrance)."
            },
            "camera_height_m": {
              "type": "number"
            }
          }
        },
        "operating_span": {
          "type": "object",
          "description": "The time the session was annotated in full. Only this span counts as analyzed time; incidents outside it are out of scope.",
          "oneOf": [
            {
              "required": [
                "start",
                "end"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "start_s"
                    ]
                  },
                  {
                    "required": [
                      "end_s"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "start_s",
                "end_s"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "start"
                    ]
                  },
                  {
                    "required": [
                      "end"
                    ]
                  }
                ]
              }
            }
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            },
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "end_s": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "hard_negatives": {
          "type": "array",
          "description": "Staged or observed non-events that look like events: a customer bending to pick something up (person_down), staff entering the walk-in cooler (restricted_zone_entry), a refund with the customer present (pos_refund_no_customer), cleaning crew inside the staff window (after_hours_intrusion), lights switched off at close (camera_tamper), a queue of four (long_queue). Never counted as positives; incidents overlapping them are reported as false positives on hard negatives.",
          "items": {
            "$ref": "#/$defs/hard_negative"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "event_type",
        "visibility",
        "annotator_confidence",
        "annotators",
        "adjudicated"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "start",
            "end"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "start_s"
                ]
              },
              {
                "required": [
                  "end_s"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "start_s",
            "end_s"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "start"
                ]
              },
              {
                "required": [
                  "end"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "enum": [
            "after_hours_intrusion",
            "camera_tamper",
            "restricted_zone_entry",
            "person_down",
            "long_queue",
            "long_wait",
            "unattended_post",
            "pos_no_sale",
            "pos_refund_no_customer"
          ],
          "description": "Core's event_type (packages/contracts/API.md). Annotate the onset of the condition as start (for dwell rules, the moment the condition first holds, not when the threshold is reached); spans shorter than the rule's threshold are hard negatives, not events."
        },
        "room_zone": {
          "type": "string",
          "description": "Core room_zone, e.g. register-1, counter-queue, walk-in-cooler, back-door."
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "visibility": {
          "enum": [
            "visible",
            "partial",
            "not_visible"
          ]
        },
        "annotator_confidence": {
          "enum": [
            "certain",
            "likely",
            "unsure"
          ]
        },
        "annotators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Pseudonymous annotator ids. Every event needs >= 2 independent annotators."
        },
        "adjudicated": {
          "type": "boolean",
          "description": "True once a senior reviewer has resolved disagreements."
        },
        "adjudicator": {
          "type": "string"
        },
        "severity_label": {
          "type": "string"
        },
        "conditions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Per-event overrides of the session conditions, e.g. {\"occlusion\": \"heavy\"}."
        },
        "notes": {
          "type": "string"
        },
        "pos_ref": {
          "type": "string",
          "description": "POS ticket or event reference for pos_* events (matches the incident's pos_ref)."
        }
      }
    },
    "hard_negative": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "start",
            "end"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "start_s"
                ]
              },
              {
                "required": [
                  "end_s"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "start_s",
            "end_s"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "start"
                ]
              },
              {
                "required": [
                  "end"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. customer_bending, staff_in_cooler, refund_with_customer, cleaning_crew, lights_off_at_close, queue_of_four"
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
